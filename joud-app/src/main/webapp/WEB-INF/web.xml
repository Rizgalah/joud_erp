<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Joud ERP System</display-name>

    <!-- ════════════════════════════════════════════════════
         Weld CDI Listener (يجب أن يكون أول listener)
    ════════════════════════════════════════════════════ -->
    <listener>
        <listener-class>org.jboss.weld.environment.servlet.Listener</listener-class>
    </listener>

    <!-- ════════════════════════════════════════════════════
         JSF Faces Servlet
    ════════════════════════════════════════════════════ -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- ════════════════════════════════════════════════════
         JSF / PrimeFaces Settings
    ════════════════════════════════════════════════════ -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>

    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ════════════════════════════════════════════════════
         Auth Filter — يحمي كل الصفحات
         المعرَّف في joud-core/AuthFilter.java
    ════════════════════════════════════════════════════ -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.joud.core.security.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ════════════════════════════════════════════════════
         Welcome Page
    ════════════════════════════════════════════════════ -->
    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!-- ════════════════════════════════════════════════════
         Session Timeout — 30 دقيقة (يتطابق مع SessionManager)
    ════════════════════════════════════════════════════ -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
            <!-- غيّر secure إلى true عند استخدام HTTPS في الإنتاج -->
        </cookie-config>
    </session-config>

    <!-- ════════════════════════════════════════════════════
         Error Pages
    ════════════════════════════════════════════════════ -->
    <error-page>
        <error-code>403</error-code>
        <location>/views/error/403.xhtml</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.xhtml</location>
    </error-page>

    <!-- ════════════════════════════════════════════════════
         Security: منع الوصول المباشر لـ WEB-INF
    ════════════════════════════════════════════════════ -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected WEB-INF</web-resource-name>
            <url-pattern>/WEB-INF/*</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>

    <!-- ════════════════════════════════════════════════════
         MIME Types إضافية
    ════════════════════════════════════════════════════ -->
    <mime-mapping>
        <extension>pdf</extension>
        <mime-type>application/pdf</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>xlsx</extension>
        <mime-type>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mime-type>
    </mime-mapping>

</web-app>
